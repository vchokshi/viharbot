# syntax=docker/dockerfile:1
# Memory service and its migration job (ADR-009, issue #40). One image, two commands: the service
# (default) and `python -m viharbot.memory_service.migrate` (run by the memory-migrate job with the
# migration role). It is the only image that installs the PostgreSQL driver (the `memory` extra).
FROM python:3.12-slim-bookworm AS build

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir --prefix=/install ".[memory]"

FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app

RUN addgroup --system --gid 1001 appgroup \
    && adduser --system --uid 1001 --ingroup appgroup appuser

COPY --from=build --chown=1001:1001 /install /usr/local

ENV PYTHONUNBUFFERED=1
ARG APP_PORT=8000
ENV PORT=${APP_PORT}
EXPOSE 8000
LABEL org.opencontainers.image.title="ViharBot memory service"

USER 1001:1001
# Stage (docs/stage-memory-design.md items 1, 2, 4): when MEMORY_STAGE_ROLE is set the launcher
# `viharbot.memory_service.stage_entry` takes over (certificate, key, key registry and database CA
# come from encrypted variables). With it unset the command below is the Compose command, unchanged.
# TLS (ADR-009): when MEMORY_TLS_CERT_FILE and MEMORY_TLS_KEY_FILE are set the service serves HTTPS
# with them; the files are mounted at run time and never baked into the image. Compose sets them.
CMD ["sh", "-c", "if [ -n \"$MEMORY_STAGE_ROLE\" ]; then exec python -m viharbot.memory_service.stage_entry; fi; if [ -z \"$MEMORY_DB_PASSWORD\" ] || { [ -n \"$MEMORY_TLS_CERT_FILE\" ] && [ ! -r \"$MEMORY_TLS_CERT_FILE\" ]; }; then echo 'memory: development credentials or certificates are missing. Run python scripts/dev_service_auth.py on the host, then docker compose up -d' >&2; exit 1; fi; exec uvicorn viharbot.memory_service.app:create_app_from_environment --factory --host 0.0.0.0 --port \"$PORT\" ${MEMORY_TLS_CERT_FILE:+--ssl-certfile \"$MEMORY_TLS_CERT_FILE\" --ssl-keyfile \"$MEMORY_TLS_KEY_FILE\"}"]
