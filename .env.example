LITELLM_BASE_URL=https://litellm.viharchokshi.com
LITELLM_API_KEY=
RESEARCH_MODEL=openai/gpt-5.4-mini
SECURITY_MODEL=openai/gpt-5.4
FACT_CHECK_MODEL=openai/gpt-5.4-mini
SOURCE_QUALITY_MODEL=openai/gpt-5.4-mini
PRIVACY_MODEL=openai/gpt-5.4-mini
SYNTHESIS_MODEL=openai/gpt-5.4-mini
RUN_LITELLM_INTEGRATION=0
RUN_LITELLM_INFERENCE=0
WEB_AUTH_ENABLED=0
WEB_USERNAME=
WEB_PASSWORD=

# Optional: Charlie's iterative coordination in the web service. Everything here is off or
# empty by default. To try it locally, set all three flags to true, choose a planner alias that
# exists in your LiteLLM, and pass a key to the web container only for that run, for example:
#   WEB_LITELLM_API_KEY="$LITELLM_API_KEY" docker compose up -d web
# Never commit a real key. CHARLIE_PLANNER_MODEL is never inferred from another alias.
VIHARBOT_IDENTITY_ROUTING_ENABLED=false
VIHARBOT_DELEGATION_ENABLED=false
VIHARBOT_ITERATIVE_ORCHESTRATION_ENABLED=false
# Dev only: lets the live stream include planner rationale and model aliases. Keep false elsewhere.
VIHARBOT_DEV_DIAGNOSTICS_ENABLED=false
CHARLIE_PLANNER_MODEL=
WEB_LITELLM_API_KEY=
