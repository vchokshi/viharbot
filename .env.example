LITELLM_BASE_URL=https://litellm.viharchokshi.com
LITELLM_API_KEY=
RESEARCH_MODEL=gpt-6.1-sol
SECURITY_MODEL=openai/gpt-5.4
FACT_CHECK_MODEL=gemini/gemini-3.5-flash
SOURCE_QUALITY_MODEL=gemini/gemini-3.5-flash
PRIVACY_MODEL=gpt-5.4-mini
SYNTHESIS_MODEL=gpt-5.4-mini
PIXEL_MODEL=gpt-5.4-mini
SAGE_MODEL=gpt-6.1-sol
RUN_LITELLM_INTEGRATION=0
RUN_LITELLM_INFERENCE=0
WEB_AUTH_ENABLED=0
WEB_USERNAME=
WEB_PASSWORD=

# The live team conversation (Charlie plans, the team answers) has no flag. It runs when the web
# container has a planner alias and a LiteLLM key. The key is opt-in and is passed only for the
# run that needs it, for example:
#   WEB_LITELLM_API_KEY="$LITELLM_API_KEY" docker compose up -d web
# Never commit a real key. CHARLIE_PLANNER_MODEL defaults to gpt-6-luna and is never inferred from
# another alias. Without the key the web service runs the fixed pipeline.
# Dev only: lets the live stream include planner rationale and model aliases. Keep false elsewhere.
VIHARBOT_DEV_DIAGNOSTICS_ENABLED=false
CHARLIE_PLANNER_MODEL=gpt-6-luna
WEB_LITELLM_API_KEY=

# Pixel slide-deck generation. True while the feature is being tested. When it is finished, set
# this to false (and the compose.yaml default) so requests never spend model calls on decks.
VIHARBOT_PPT_GENERATION_ENABLED=true
PIXEL_TARGET_SLIDES=6
PIXEL_MAX_MODEL_CALLS=8

# Archie's GitHub learning pipeline (scripts/archie_learn.py). Use fine-grained tokens; never commit them.
# Source token: read-only on the ViharBot repo. Instructor token: contents and pull-requests write on
# the instructor repo only. Neither token can or should merge.
# Comma-separated GitHub logins allowed to assign/cancel Archie curriculum work. Empty = nothing can be assigned.
ARCHIE_FOUNDER_LOGINS=
ARCHIE_SOURCE_TOKEN=
ARCHIE_INSTRUCTOR_TOKEN=
