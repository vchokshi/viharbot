{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullKeplerImageOnly",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:*:ACCOUNT_ID:repository/viharbot/kepler"
    },
    {
      "Sid": "EcrAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "LogsInKeplerGroupsOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": [
        "arn:aws:logs:*:ACCOUNT_ID:log-group:/aws/bedrock-agentcore/runtimes/*",
        "arn:aws:logs:*:ACCOUNT_ID:log-group:/viharbot/kepler*",
        "arn:aws:logs:*:ACCOUNT_ID:log-group:/aws/lambda/viharbot-kepler-*"
      ]
    },
    {
      "Sid": "OwnMetricsNamespaceOnly",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "ViharBot/Kepler" } }
    },
    {
      "Sid": "ReadKeplerSecretsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:*:ACCOUNT_ID:secret:viharbot/kepler/*"
    },
    {
      "Sid": "KeplerTablesDataOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:*:ACCOUNT_ID:table/viharbot-kepler-*"
    },
    {
      "Sid": "PublishKeplerAlertsOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:ACCOUNT_ID:viharbot-kepler-*"
    },
    {
      "Sid": "InvokeKeplerFunctionsOnly",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:*:ACCOUNT_ID:function:viharbot-kepler-*"
    },
    {
      "Sid": "InvokeAgentRuntimesInThisAccountOnly",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": "arn:aws:bedrock-agentcore:*:ACCOUNT_ID:runtime/*"
    },
    {
      "Sid": "InvokeAllowlistedNonAnthropicModelOnly",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "arn:aws:bedrock:*::foundation-model/meta.llama3-1-8b-instruct-v1:0"
    },
    {
      "Sid": "DenyEveryOtherFoundationModel",
      "Effect": "Deny",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "NotResource": "arn:aws:bedrock:*::foundation-model/meta.llama3-1-8b-instruct-v1:0"
    },
    {
      "Sid": "NeverInvokeAnthropic",
      "Effect": "Deny",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": ["arn:aws:bedrock:*::foundation-model/anthropic.*", "arn:aws:bedrock:*:*:inference-profile/*anthropic*"]
    },
    {
      "Sid": "NeverChangeIdentityOrBilling",
      "Effect": "Deny",
      "Action": ["iam:*", "organizations:*", "account:*", "billing:*", "aws-portal:*", "sts:AssumeRole"],
      "Resource": "*"
    }
  ]
}
